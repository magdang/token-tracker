// Merge only this property into your existing top-level Waybar object.
// Keep your current modules-right and insert "custom/token-tracker" immediately
// before the Wi-Fi/network module that is actually present there.
{
  "custom/token-tracker": {
    "exec": "'/absolute/path with spaces/token-tracker/bin/token-tracker' waybar",
    "on-click": "'/absolute/path with spaces/token-tracker/bin/token-tracker' accounts",
    "return-type": "json",
    "restart-interval": 5,
    "tooltip": true
  }
}

// Do not add "interval": the executable is a continuous JSON stream.
// restart-interval only restarts the command if that stream exits.
